# ============================================================================
# wechat-daily 配置模板
#
# 用法（推荐）：
#   node scripts/setup.mjs          # 交互式向导，自动生成本文件对应的 .env
#   npm run setup                   # 同上
#
# 手动用法：
#   cp .env.example .env            # Windows: copy .env.example .env
#   然后只填标了「必填」的项
#
# 安全：
#   - .env 已在 .gitignore 里，永远不要提交
#   - 文件权限保持 600（setup 脚本会自动设置）
#   - 密钥只放这一处，不要写进代码或 README
# ============================================================================

# ---------------------------------------------------------------------------
# 一、微信公众号（必填）
# ---------------------------------------------------------------------------
# 公众平台 → 设置与开发 → 基本配置 → 开发者ID(AppID)
# 形如 wx + 16 位十六进制（这里不写真实值）
WECHAT_APPID=

# 公众平台 → 设置与开发 → 基本配置 → 开发者密码(AppSecret)
# 个人主体需要管理员微信扫码启用；启用后把本机出口 IP 加进同页的「IP 白名单」
# 不知道出口 IP 是多少？先随便填，跑 `npm run whitelist` 会从微信的 40164 报错里读出来
WECHAT_APPSECRET=

# 草稿箱里的作者名（可留空）
WECHAT_AUTHOR=

# 文末「阅读原文」链接（可留空）
WECHAT_SOURCE_URL=

# 可选：微信 API 中转地址。默认 https://api.weixin.qq.com
# 出口 IP 不固定、白名单填不完时，可以用一台固定 IP 的小机器反向代理，然后填这里
# WECHAT_BASE_URL=

# ---------------------------------------------------------------------------
# 二、写稿模型（必填，任何 OpenAI 兼容接口都行）
# ---------------------------------------------------------------------------
# 历史原因这些变量叫 OPENCODE_*，但它们不绑定 OpenCode：
# 只要服务端实现了 /chat/completions，就能用。
#
# 默认值对应 OpenCode Go（作者用的订阅）。换成别家时，改下面三个即可。
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4.1-flash

# 选题 / 大纲 / 自检 / 看图写图注 用的模型
# 留空则复用 OPENCODE_MODEL。文献配图需要模型支持图片输入（多模态）
OPENCODE_MODEL_FAST=
# 视觉模型（只用于看论文里的图）；留空则复用 OPENCODE_MODEL_FAST
# PAPER_VISION_MODEL=

# 换别家时的参考（取消注释，改成自己的）：
# DeepSeek 官方
# OPENCODE_BASE_URL=https://api.deepseek.com/v1
# OPENCODE_MODEL=deepseek-chat
# OPENCODE_MODEL_FAST=deepseek-chat
#
# 月之暗面 Kimi
# OPENCODE_BASE_URL=https://api.moonshot.cn/v1
# OPENCODE_MODEL=moonshot-v1-32k
#
# OpenAI
# OPENCODE_BASE_URL=https://api.openai.com/v1
# OPENCODE_MODEL=gpt-4.1-mini

# ---------------------------------------------------------------------------
# 三、发布模式
# ---------------------------------------------------------------------------
# draft       = 只进草稿箱，人工在「订阅号助手」点群发（个人主体的唯一可行方式）
# freepublish = 调 freepublish/submit 直接发表（需企业/已认证主体，个人号会报 48001）
PUBLISH_MODE=draft

# ---------------------------------------------------------------------------
# 四、通知（可选）
# ---------------------------------------------------------------------------
# none | webhook | serverchan
NOTIFY_CHANNEL=none
NOTIFY_WEBHOOK_URL=
NOTIFY_SERVERCHAN_KEY=

# 定时任务/机器人使用的时区（默认 Asia/Shanghai）
# 只影响 bin/daily.sh 和机器人子进程；发文日期以 config/site.yaml 的 timezone 为准
# WX_TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# 五、企业微信机器人（可选，做「交互式发文」才需要）
# ---------------------------------------------------------------------------
# 企业微信后台 → 我的企业 → 企业信息 → 企业ID
WECOM_CORPID=
# 应用管理 → 你的应用 → Secret / AgentId
WECOM_CORPSECRET=
WECOM_AGENTID=
# 接收消息 → API接收：Token / EncodingAESKey（43 位）
WECOM_TOKEN=
WECOM_AESKEY=
# 允许操作机器人的成员 UserID，逗号分隔；留空 = 不校验（危险，别这么干）
WECOM_ALLOWED_USERS=
# 智能机器人（另一种接入方式，和上面的自建应用二选一）
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# 回调服务监听端口（建议只监听 127.0.0.1，公网入口用 Tailscale Funnel / 反代）
BOT_PORT=8899

# ---------------------------------------------------------------------------
# 六、手机网页入口（可选）
# ---------------------------------------------------------------------------
WEB_PORT=8788
# 随机字符串，相当于密码。不配则 src/web/server.js 拒绝启动
WEB_TOKEN=
# 默认 0.0.0.0；只想内网访问就改成该网卡地址或 127.0.0.1
WEB_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# 七、pi agent（可选，机器人把复杂指令交给它才需要）
# ---------------------------------------------------------------------------
# pi 可执行文件路径；默认在 PATH 里找
# PI_BIN=/usr/local/bin/pi
# pi 的模型标识（provider/model 形式）
PI_MODEL=opencode-go/deepseek-v4.1-flash
# off | minimal | low | medium | high | xhigh | max | auto
# auto = 不传 --thinking，用 pi 自己的默认档位
PI_THINKING=auto
